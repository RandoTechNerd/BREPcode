node_modules/

# Build outputs — regenerated by `node build-site.mjs` and `npm run desktop:build`.
# The exe is ~92MB; it belongs on a GitHub Release, not in git history.
dist-site/
dist-desktop/
BREPcode-site.zip

# One-off models produced while answering a question — handed to the user, not
# part of the source. Regenerate rather than commit.
out/

# Readouts from the Electron test harnesses (electron.exe is a GUI binary and
# its stdout can vanish when redirected, so they write their results here).
/*-check.log
/*-probe.log

# Scratch models and exports left behind while testing
/*.stl
/*.3mf
/*.gcode
viewer/*.stl
viewer/*.3mf

# A local test stash for the hidden model library (triple-tap the folder icon
# in the (i) card). Personal models don't belong in a public repo; the site
# build writes its own empty manifest.
viewer/secret-models/

# The AES blob holding a personal API key. Publishing it would let anyone
# brute-force the password offline, so it stays local by default — see the
# note in README about supplying your own key.
viewer/locked-key.js
